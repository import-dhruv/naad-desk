# Oogam credentials — NEVER commit a real key. This file is a template.
OOGAM_API_KEY=sk-setu-REPLACE_ME
OOGAM_REST_BASE=https://platform.oogam.ai/v1
OOGAM_WS_URL=wss://platform.oogam.ai/v1/realtime?v=2
OOGAM_SUTRA_MODEL=sutra-conversation
OOGAM_TTS_MODEL=naad-tts-v2
OOGAM_STT_MODEL=naad-stt-v2

# Realtime defaults
NAAD_VOICE=f1
NAAD_LANG=hi
VAD_END_SILENCE_MS=700

# Local app
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./naad_desk.db
LOG_LEVEL=INFO

# Spend / reliability guards (paise)
COST_CEILING_PAISE=5000
MONTHLY_BUDGET_PAISE=100000
MAX_CALL_SECONDS=600
RECONNECT_BACKOFF_MS=1000,2000,4000

# Retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_CONFIDENCE=0.50

# Timezone
TZ=Asia/Kolkata

# Frontend (Vite dev proxy target)
VITE_API_BASE=http://localhost:8000
